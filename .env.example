# Copy to .env for local/dev runs: cp .env.example .env

# --- Server ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated origins allowed to connect over HTTP/WebSocket.
CORS_ORIGIN=http://localhost:5173

# --- Web client ---
# Base URL the browser uses to reach the game server.
VITE_SERVER_URL=http://localhost:3001

# --- Accounts (DesignNotes 1-2) ---
# Set false to close a server to new signups; existing accounts still work.
REGISTRATION_ENABLED=true
# Signs session tokens. Generate with: openssl rand -hex 32
# Development picks a random one each boot, which signs everyone out on restart.
SESSION_SECRET=

# --- Postgres ---
POSTGRES_USER=berserk
POSTGRES_PASSWORD=berserk
POSTGRES_DB=berserk
DATABASE_URL=postgresql://berserk:berserk@db:5432/berserk

# --- Card art ---
# Directory of card images, served at /cards.
CARD_DIR=./art-assets/cards

# Usernames promoted to operator on boot, comma-separated. An operator can
# reset another player's password from Settings — this server sends no email,
# so that is the only way back in for somebody locked out.
ADMIN_USERS=
